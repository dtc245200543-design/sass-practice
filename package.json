{
  "name": "sass-practice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sass:version": "sass --version",
    "build:single": "sass --no-source-map styles.scss styles.css",
    "watch:single": "sass --no-source-map --watch styles.scss:styles.css",
    "build:all": "sass --no-source-map scss:css",
    "watch:all": "sass --no-source-map --watch scss:css"
  },
  "devDependencies": {
    "sass": "^1.89.0"
  }
}
